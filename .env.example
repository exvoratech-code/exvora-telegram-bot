# ==========================================
# EXVORA TELEGRAM MINI APP + BOTS
# ==========================================
# Скопируй этот файл в .env и заполни реальными значениями.
# НИКОГДА не коммить .env в git!

# ------------------------------------------
# TELEGRAM BOTS
# ------------------------------------------

# Главный бот (пользователи открывают Mini App через него)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Уведомляющий бот (@ExvoraTechNotify)
NOTIFY_BOT_TOKEN=123456789:BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB

# ------------------------------------------
# MINI APP
# ------------------------------------------

# Публичный HTTPS URL мини-приложения
# Обязательно выполни /setdomain в @BotFather
WEBAPP_URL=https://your-miniapp-domain.com

# ------------------------------------------
# AMLBOT (https://amlbot.com)
# ------------------------------------------
AMLBOT_ACCESS_ID=your_numeric_id
AMLBOT_ACCESS_KEY=your_long_secret_key

# ------------------------------------------
# PLATEGA (https://platega.io)
# ------------------------------------------
PLATEGA_MERCHANT_ID=your_merchant_id
PLATEGA_SECRET=your_platega_secret

# ------------------------------------------
# NOTIFICATIONS
# ------------------------------------------

# ID чата/группы, куда приходят уведомления (включая платежи AML)
ADMIN_CHAT_ID=-1001234567890

# Fallback: если не удалось отправить в основную группу — отправим сюда (личный чат админа)
# Получить ID можно через @userinfobot
FALLBACK_ADMIN_ID=123456789

# Стоимость AML-проверки
AML_CHECK_PRICE_USD=0.70

# ------------------------------------------
# SERVER
# ------------------------------------------
NODE_ENV=development
PORT=3001
